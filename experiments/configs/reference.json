{
  "name": "reference",
  "description": "Optional separate high-budget Full Context reference on matched main samples; excluded from same-budget comparisons.",
  "model": {"provider": null, "name": null, "temperature": 0, "max_output_tokens": 512},
  "dataset": {"source": "synthetic", "samples_per_cell": 20, "task_types": ["temporal_update", "approval"]},
  "strategies": ["long_context_reference"],
  "seeds": [42, 43],
  "repeats": 2,
  "grid": {
    "context_token_budget": [131072],
    "history_length_tokens": [25000],
    "horizon_turns": [10, 50, 100],
    "noise_memory_ratio": [0.5],
    "constraint_count": [3],
    "state_update_count": [2]
  },
  "evaluation": {
    "retrieval_k": 20,
    "bootstrap_iterations": 2000,
    "bootstrap_seed": 42,
    "group_by": ["strategy", "context_token_budget", "history_length_tokens", "horizon_turns"],
    "delta_group_by": ["context_token_budget", "history_length_tokens", "horizon_turns"]
  },
  "budget_policy": {"scope": "total_input", "mandatory_overflow": "stop_and_log", "full_context": "reference_only"},
  "output_directory": "experiments/results/reference"
}
