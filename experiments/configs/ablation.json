{
  "name": "ablation",
  "description": "Component contribution; strategy implementations are provided by the memory/agent owner.",
  "model": {"provider": null, "name": null, "temperature": 0, "max_output_tokens": 512},
  "dataset": {"source": "synthetic", "samples_per_cell": 30, "task_types": ["temporal_update", "approval"]},
  "strategies": ["proposed", "without_protected_memory", "without_state_versioning", "without_budget_optimization"],
  "strategy_options": {
    "proposed": {"protect_constraints": true, "resolve_state_versions": true, "flexible_selection": "utility_per_token"},
    "without_protected_memory": {"protect_constraints": false, "resolve_state_versions": true, "flexible_selection": "utility_per_token"},
    "without_state_versioning": {"protect_constraints": true, "resolve_state_versions": false, "flexible_selection": "utility_per_token"},
    "without_budget_optimization": {"protect_constraints": true, "resolve_state_versions": true, "flexible_selection": "retrieval_order"}
  },
  "seeds": [42, 43, 44],
  "repeats": 3,
  "grid": {
    "context_token_budget": [1024, 2048, 4096, 8192],
    "history_length_tokens": [25000],
    "horizon_turns": [10, 50, 100],
    "noise_memory_ratio": [0.5],
    "constraint_count": [3],
    "state_update_count": [2]
  },
  "evaluation": {
    "retrieval_k": 20,
    "bootstrap_iterations": 2000,
    "bootstrap_seed": 42,
    "group_by": ["strategy", "context_token_budget", "horizon_turns"],
    "delta_group_by": ["context_token_budget", "horizon_turns"]
  },
  "budget_policy": {"scope": "total_input", "mandatory_overflow": "stop_and_log", "full_context": "reference_only_if_over_budget"},
  "output_directory": "experiments/results/ablation"
}
